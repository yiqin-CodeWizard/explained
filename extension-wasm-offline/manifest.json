{
  "manifest_version": 3,
  "name": "extension-wasm-offline",
  "version": "0.2.1",
  "minimum_chrome_version": "114",
  "description": "Understand highlighted text and explore recent news using DeepSeek APIs and your own key.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "extension-wasm-offline \u00b7 reading companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "shared.js",
        "reader-styles.js",
        "reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'self' https://api.deepseek.com;"
  }
}
